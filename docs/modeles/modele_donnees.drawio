<diagram name="MCD — modele conceptuel (Merise)" id="d1842ff09738">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1980" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="legende" value="LEGENDE — MCD (Merise)&#10;Entites METIER et associations, avec cardinalites (min,max).&#10;Ni type, ni cle technique : un MCD dit ce que le domaine contient,&#10;pas comment PostgreSQL le stocke.&#10;Lecture : SERIE-SOURCE (0,n) --designe--&gt; (0,1) OEUVRE se lit&#10;« une serie designe au plus une oeuvre ; une oeuvre est designee&#10;par zero a n series de sources differentes »." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#37474F;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="460" height="200" as="geometry" /></mxCell>
<mxCell id="titre" value="MCD — modele conceptuel (Merise)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="80" width="900" height="50" as="geometry" /></mxCell>
