# Copier en verification/.env (ignoré par git). Chaque clé n'est lue que par une
# étape de make verify-poste.
#
# APIMANGA_VERIF_DSN : lu par verification/etat_apimanga.sh, et par lui seul —
# l'étape « état d'apimanga ».
# Rôle verif_lecture (membre de verif_ro, migration 022), créé par
# database/outils/creer_role_verification.sh. Aucun mot de passe ici : il est dans
# ~/.pgpass (localhost:5432:apimanga:verif_lecture:<mot de passe>, chmod 600).
APIMANGA_VERIF_DSN=postgresql://verif_lecture@localhost:5432/apimanga

# Lu par l'étape « équivalence de l'API » de make verify-poste, et par elle seule
# (verifier.sh equivalence) : passé au seul test d'égalité avec le banc du module 11.
# Rôle modele_api (membre de modele_ro, migration 023), créé par
# database/outils/creer_role_modele.sh ; mot de passe dans ~/.pgpass
# (localhost:5432:apimanga:modele_api:<mot de passe>, chmod 600).
APIMANGA_MODELE_DSN=postgresql://modele_api@localhost:5432/apimanga
