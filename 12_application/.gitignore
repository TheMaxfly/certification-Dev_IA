# Environnements et artefacts Python
.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets et adresses : seul `.env.example` est versionné. `.env.staging` (E4, lot 8) :
# la clé de session de la cible staging.
.env
.env.*
!.env.example

# Le pgpass monté dans le conteneur de l'application (Compose, E4, lot 8) : un secret.
.pgpass.conteneur

# La sortie brute de l'audit d'accessibilité : régénérée par `make verify-poste`, gardée
# sur le poste pour ne réécrire le rapport que si le résultat change. Seul
# `accessibilite/rapport_axe.md` est versionné (E4, lot 6).
accessibilite/rapport_axe.json
