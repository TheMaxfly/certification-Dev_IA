# Les noms seuls. À copier en `.env` (ignoré par git), puis à remplir.
#
# La clé de l'application : le secret seul, sans son nom ; la même valeur que le secret
# du consommateur `application` dans le trousseau de l'API (API_MODELE_CLES). Vide :
# l'application refuse de démarrer.
APPLICATION_CLE_API=
# L'adresse de l'API du modèle (facultatif) ; défaut : config/reglages.toml.
API_MODELE_ADRESSE=
# L'écoute de l'application, hôte:port (facultatif) ; défaut : config/reglages.toml.
APPLICATION_ECOUTE=
# Les réseaux admis à lire /metrics, séparés par des virgules (facultatif) ; défaut : le
# bouclage.
APPLICATION_METRIQUES_RESEAUX=
# Environnement : developpement (défaut), preproduction ou production. La base du DSN doit
# être celle de l'environnement (preproduction : apimanga_preprod ; production : apimanga) ;
# en développement, apimanga est refusée.
APPLICATION_ENVIRONNEMENT=
# Base de l'application, facultative (sans elle, les comptes sont indisponibles et le
# conseiller fonctionne ; make app-admin-creer l'exige). DSN SANS mot de passe : il se range
# dans ~/.pgpass. Exemple : postgresql://app_conseiller@localhost:5432/apimanga_preprod
APPLICATION_BASE_DSN=
# Clé de signature des sessions, 32 octets au moins ; obligatoire en preproduction et en
# production ; absente en développement : clé éphémère tirée au démarrage. Une clé par
# environnement.
APPLICATION_CLE_SESSION=
