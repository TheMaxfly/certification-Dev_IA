# Copier en `.env` (exclu du dépôt) et remplir. Ne jamais versionner `.env`.

# Jeton Hugging Face en lecture, pour EmbeddingGemma (modèle à accès contrôlé :
# licence à accepter sur la page du modèle). Transmis à cette seule instance.
HF_TOKEN=

# Cache Hugging Face de l'hôte, monté dans le conteneur (défaut :
# ~/.cache/huggingface/hub).
HF_HUB_CACHE_HOTE=

# Utilisateur et groupe de l'hôte (`id -u`, `id -g`) : le conteneur écrit dans
# le cache avec ces droits plutôt qu'en root (défaut : 1000:1000).
HOTE_UID=
HOTE_GID=
