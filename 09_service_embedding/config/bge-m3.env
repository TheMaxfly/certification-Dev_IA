# Instance BGE-M3 du service d'embedding (Text Embeddings Inference 1.9.4).
#
# Format : KEY=VALUE, une clé par ligne, commentaire au-dessus (valeur, motif).
# Les noms en MAJUSCULES sans préfixe sont les variables documentées du service
# (`text-embeddings-router --help`, page « CLI arguments ») : il les lit
# directement. Les clés `CLIENT_*` sont lues par le client
# (`service_embedding.configuration`) et ignorées par le service.

# --- Modèle -----------------------------------------------------------------

# Modèle servi. Motif : décision figée de la spec E2 (§1), 1 024 dimensions.
MODEL_ID=BAAI/bge-m3

# Révision des poids, par commit. Motif : celle mesurée le 2026-10-02 ; une
# branche (`main`) peut bouger en amont et changer les vecteurs sans prévenir.
REVISION=5617a9f61b028005a4858fdac845db406aefb181

# Précision : float32 (décision de Max, 2026-10-07). Motif : les deux modèles
# sont comparés à précision égale, et à la précision des questions encodées sur
# CPU en production. Le service n'offre que float16 et float32 (pas de
# bfloat16). Coût connu : environ 40 min d'encodage du corpus sur GPU au lieu de
# 10 en float16 (mesures du 2026-10-02).
DTYPE=float32

# Pooling : non fixé ici. Motif : le service le lit dans `1_Pooling/config.json`
# du modèle (CLS pour BGE-M3) ; le forcer ne pourrait que s'en écarter.

# --- Longueur ---------------------------------------------------------------

# Jetons au plus dans un lot du service : 2 048 (défaut : 16 384). Motif : en
# float32, le service préchauffe le modèle avec un lot de MAX_BATCH_TOKENS jetons
# en séquences de la longueur maximale, sans Flash Attention (réservée à la
# demi-précision). À 16 384 jetons, une séquence de 8 192 : CUDA_ERROR_OUT_OF_MEMORY
# sur les 6 Go de la carte (constaté le 2026-10-07, 12:00 UTC). À 2 048, la
# matrice d'attention d'une séquence pèse 0,27 Go.
MAX_BATCH_TOKENS=2048

# Troncature automatique du SERVICE activée. Motif : imposée par la ligne
# précédente — le modèle déclare 8 192 jetons (`sentence_bert_config.json`), plus
# que MAX_BATCH_TOKENS, et le service refuse alors de démarrer sans elle ; il
# ramène sa longueur maximale à MAX_BATCH_TOKENS. Rien n'est tronqué en silence
# pour autant : le client envoie `truncate: false` à chaque requête, et une
# entrée trop longue est refusée (contrôle « au-delà de la longueur maximale »).
AUTO_TRUNCATE=true

# Longueur maximale d'une entrée, en jetons : 2 048, celle que `/info` doit
# rendre (= MAX_BATCH_TOKENS, cf. ci-dessus). Motif : elle couvre le plus long
# fragment du corpus, 529 jetons XLM-R (mesuré le 2026-09-30), près de quatre
# fois.
CLIENT_LONGUEUR_MAXIMALE=2048
CLIENT_LONGUEUR_REQUISE=529

# --- Lots -------------------------------------------------------------------

# Entrées au plus par requête cliente : 64. Motif : plafond côté service ; le lot
# réellement envoyé est CLIENT_TAILLE_LOT, qui peut monter jusqu'ici sans
# redémarrer l'instance.
MAX_CLIENT_BATCH_SIZE=64

# Fragments par requête du client : 16. Motif : lot de départ fixé par la spec
# (§6) ; il n'augmente que si le pic de mémoire vidéo reste sous 4 Go.
CLIENT_TAILLE_LOT=16

# Fils de tokenisation : 4 (défaut : un par cœur, soit 16). Motif : chaque fil
# porte sa copie du tokenizer, et la mémoire vive de la machine est le facteur
# limitant ; le GPU, pas la tokenisation, borne le débit.
TOKENIZATION_WORKERS=4

# --- Préfixes (appliqués par le client) ---------------------------------------

# Aucun préfixe pour BGE-M3. Motif : la fiche du modèle n'en prévoit pas pour la
# recherche dense ; fragments et questions sont encodés tels quels.
CLIENT_PREFIXE_DOCUMENT=""
CLIENT_PREFIXE_REQUETE=""

# Dimension attendue des vecteurs. Motif : contrôle (1_Pooling, 1 024).
CLIENT_DIMENSION=1024

# --- Réseau -----------------------------------------------------------------

# Adresse d'écoute DANS le conteneur : 0.0.0.0. Motif : Docker fixe HOSTNAME au
# nom du conteneur, que le service lit comme adresse (« Invalid hostname ») ;
# l'exposition reste limitée à 127.0.0.1 par compose.yml.
HOSTNAME=0.0.0.0

# Port HTTP du service : 8081. Motif : un port par instance, publié sur
# 127.0.0.1 seulement par compose.yml (qui doit porter la même valeur).
PORT=8081

# Port des métriques Prometheus : 8081, celui du service, chemin `/metrics`.
# Motif : constaté le 2026-10-07 sur 1.9.4 — le port PROMETHEUS_PORT documenté
# (défaut 9000) n'est jamais ouvert : le service construit son écouteur sans le
# lancer (`let (recorder, _) = prom_builder.build()`, router/src/http/server.rs)
# et ne sert les métriques que sur son port HTTP. PROMETHEUS_PORT n'est donc ni
# réglé ni publié ; les compteurs n'apparaissent qu'après la première requête.
CLIENT_PORT_METRIQUES=8081

# Hôte où le client joint l'instance — un réglage, plus une constante du code
# (E3, étape 1). Motif : le port n'est publié que sur 127.0.0.1 (compose.yml) ;
# une instance processeur ou distante se désigne ici, sous son propre nom.
CLIENT_HOTE=127.0.0.1

# Cache des poids dans le conteneur. Motif : le volume monté par compose.yml.
HUGGINGFACE_HUB_CACHE=/data
