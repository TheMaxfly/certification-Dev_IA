# Instance EmbeddingGemma du service d'embedding (Text Embeddings Inference 1.9.4).
#
# Format : KEY=VALUE, une clé par ligne, commentaire au-dessus (valeur, motif).
# Les noms en MAJUSCULES sans préfixe sont les variables documentées du service
# (`text-embeddings-router --help`, page « CLI arguments ») : il les lit
# directement. Les clés `CLIENT_*` sont lues par le client
# (`service_embedding.configuration`) et ignorées par le service.
# Le jeton d'accès (modèle à accès contrôlé) n'est PAS ici : `.env`, hors dépôt.

# --- Modèle -----------------------------------------------------------------

# Modèle servi. Motif : décision figée de la spec E2 (§1), 768 dimensions.
MODEL_ID=google/embeddinggemma-300m

# Révision des poids, par commit. Motif : celle mesurée le 2026-10-02 (empreintes
# sha256 des cinq fichiers LFS vérifiées ce jour-là).
REVISION=57c266a740f537b4dc058e1b0cda161fd15afa75

# Précision : float32 (décision de Max, 2026-10-07). Motif : les deux modèles
# sont comparés à précision égale, et à la précision des questions encodées sur
# CPU en production. C'est aussi la seule possible ici : la fiche du modèle exclut
# float16 (« activations do not support float16 ») et le service n'offre pas
# bfloat16 (valeurs possibles : float16, float32) ; il retient d'ailleurs float32
# de lui-même pour `gemma3_text` quand DTYPE est absent.
DTYPE=float32

# Pooling : non fixé ici. Motif : le service le lit dans `1_Pooling/config.json`
# (moyenne), puis applique les deux couches `2_Dense` et `3_Dense` déclarées
# dans `modules.json`.

# --- Longueur ---------------------------------------------------------------

# Troncature automatique désactivée. Motif : un fragment trop long doit faire
# échouer la requête, pas être encodé tronqué en silence.
AUTO_TRUNCATE=false

# Longueur maximale d'une entrée, en jetons : 2 048. Motif : valeur que le
# service lit dans `sentence_bert_config.json` (`max_seq_length`) ; elle n'est
# pas réglable. Le contrôle exige que `/info` la rende, et qu'elle couvre le plus
# long fragment préfixé du corpus (586 jetons Gemma, mesuré le 2026-10-02).
CLIENT_LONGUEUR_MAXIMALE=2048
CLIENT_LONGUEUR_REQUISE=586

# --- Lots -------------------------------------------------------------------

# Jetons au plus dans un lot du service : 16 384 (valeur par défaut, écrite pour
# être lue). Motif : doit couvrir la longueur maximale (2 048).
MAX_BATCH_TOKENS=16384

# Entrées au plus par requête cliente : 64. Motif : plafond côté service ; le lot
# réellement envoyé est CLIENT_TAILLE_LOT, qui peut monter jusqu'ici sans
# redémarrer l'instance.
MAX_CLIENT_BATCH_SIZE=64

# Fragments par requête du client : 16. Motif : lot de départ fixé par la spec
# (§6) ; il n'augmente que si le pic de mémoire vidéo reste sous 4 Go.
CLIENT_TAILLE_LOT=16

# Fils de tokenisation : 4 (défaut : un par cœur, soit 16). Motif : chaque fil
# porte sa copie du tokenizer (33 Mo de `tokenizer.json` pour Gemma), et la
# mémoire vive est le facteur limitant de la machine.
TOKENIZATION_WORKERS=4

# --- Préfixes (appliqués par le client) ---------------------------------------

# Préfixes de la fiche du modèle (prompts `document` et `query` de
# `config_sentence_transformers.json`). Motif : EmbeddingGemma est entraîné avec ;
# le client les ajoute, le service n'en applique aucun (pas de
# DEFAULT_PROMPT_NAME). Guillemets obligatoires : l'espace final fait partie du
# préfixe.
CLIENT_PREFIXE_DOCUMENT="title: none | text: "
CLIENT_PREFIXE_REQUETE="task: search result | query: "

# Dimension attendue des vecteurs. Motif : contrôle (sortie de `3_Dense`, 768).
CLIENT_DIMENSION=768

# --- Réseau -----------------------------------------------------------------

# Adresse d'écoute DANS le conteneur : 0.0.0.0. Motif : Docker fixe HOSTNAME au
# nom du conteneur, que le service lit comme adresse (« Invalid hostname ») ;
# l'exposition reste limitée à 127.0.0.1 par compose.yml.
HOSTNAME=0.0.0.0

# Port HTTP du service : 8082. Motif : un port par instance, publié sur
# 127.0.0.1 seulement par compose.yml (qui doit porter la même valeur).
PORT=8082

# Port des métriques Prometheus : 8082, celui du service, chemin `/metrics`.
# Motif : constaté le 2026-10-07 sur 1.9.4 — le port PROMETHEUS_PORT documenté
# (défaut 9000) n'est jamais ouvert : le service construit son écouteur sans le
# lancer (`let (recorder, _) = prom_builder.build()`, router/src/http/server.rs)
# et ne sert les métriques que sur son port HTTP. PROMETHEUS_PORT n'est donc ni
# réglé ni publié ; les compteurs n'apparaissent qu'après la première requête.
CLIENT_PORT_METRIQUES=8082

# Cache des poids dans le conteneur. Motif : le volume monté par compose.yml.
HUGGINGFACE_HUB_CACHE=/data
