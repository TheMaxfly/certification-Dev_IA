# shellcheck shell=bash
# cles-fournisseurs — les clés d'API des fournisseurs de modèle de langage, et le
# jeton Hugging Face. Ce fragment est sourcé par les hooks pre-commit et pre-push,
# et ne s'exécute pas seul : un seul jeu de motifs, qui ne peut pas diverger d'un
# hook à l'autre.
#
# Sur les lignes ajoutées (« chemin<TAB>ligne », sur l'entrée de controler_cles),
# pour chaque fournisseur :
#   - VALEUR RÉELLE : la clé du poste, lue dans sa variable d'environnement, dans
#     le fichier où l'outil du fournisseur la range (le jeton Hugging Face), et dans
#     les fichiers .env de la racine et des dossiers jusqu'à deux niveaux sous elle
#     (ceux des modules, ignorés par git). Variable absente ou vide : rien à
#     comparer, aucun message ;
#   - ASPECT : une chaîne qui a la forme d'une clé du fournisseur.
# Le refus nomme le fournisseur et le fichier, jamais la valeur. La valeur ne passe
# jamais en argument d'une commande (visible dans la liste des processus) : grep la
# lit sur un descripteur. Les lignes sont lues en texte (grep -a) : sinon, grep tait
# une ligne qui porte un octet hors UTF-8, et la clé qu'elle contient passerait.
#
# Formes relevées dans la documentation officielle le 2026-10-19 :
#   - OpenAI : le préfixe « sk- » (« sk-admin- » pour une clé d'administration) ;
#     ni longueur ni alphabet documentés. Motif : « sk- » en début de mot, suivi
#     d'au moins 40 caractères [A-Za-z0-9_-] — les exemples courts passent (ceux de
#     la documentation, le faux jeton des tests du module 05).
#   - Mistral : forme non documentée (un exemple masqué, alphanumérique, sans
#     préfixe). Motif : une affectation littérale à MISTRAL_API_KEY (« = » ou « : »,
#     casse indifférente) d'au moins 20 caractères alphanumériques, la forme d'un
#     .env recopié. La valeur réelle reste le filet.
#   - Hugging Face : « hf_ » suivi de 34 caractères alphanumériques ; la valeur du
#     poste est aussi lue dans le fichier où `huggingface-cli login` la range.
#
#
# Les clés d'accès à l'API du modèle, propres au dépôt (E3, étape 4) :
#   - API_MODELE_CLES : le trousseau, « nom:secret,nom:secret », secret de 32 caractères
#     au moins. Chaque secret est une valeur à comparer (cles_decouper) ; le motif voit
#     une affectation littérale, y compris d'un secret en second élément ;
#   - APPLICATION_CLE_API : le secret seul, côté application. Motif : une affectation
#     littérale de 32 caractères au moins ; une référence (« ${…} ») n'en est pas une.
#
# Ajouter un fournisseur : son nom de variable dans CLES_VARIABLES, une entrée dans
# CLES_FOURNISSEUR et dans CLES_ASPECT (et, s'il y a lieu, CLES_NATURE, CLES_FICHIER).

CLES_VARIABLES=(MISTRAL_API_KEY OPENAI_API_KEY HF_TOKEN API_MODELE_CLES APPLICATION_CLE_API)
declare -A CLES_FOURNISSEUR=([MISTRAL_API_KEY]=Mistral [OPENAI_API_KEY]=OpenAI [HF_TOKEN]="Hugging Face"
    [API_MODELE_CLES]="du trousseau de l'API" [APPLICATION_CLE_API]="de l'application")
declare -A CLES_NATURE=([HF_TOKEN]=jeton)  # « clé » sinon
declare -A CLES_ASPECT=(
    [MISTRAL_API_KEY]="[Mm][Ii][Ss][Tt][Rr][Aa][Ll]_[Aa][Pp][Ii]_[Kk][Ee][Yy][\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9]{20,}"
    [OPENAI_API_KEY]='(^|[^A-Za-z0-9_-])sk-[A-Za-z0-9_-]{40,}'
    [HF_TOKEN]='hf_[A-Za-z0-9]{34}'
)
# Les clés d'accès à l'API du modèle, à part : ce ne sont pas des clés de fournisseur.
CLES_ASPECT[API_MODELE_CLES]="API_MODELE_CLES[\"']?[[:space:]]*[:=][[:space:]]*[\"']?([a-z0-9_-]+:[^[:space:],\"']*,)*[a-z0-9_-]+:[^[:space:],\"']{32,}"
CLES_ASPECT[APPLICATION_CLE_API]="APPLICATION_CLE_API[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[^[:space:]\"'\$]{32,}"
# Le mot de passe d'application du canal d'alerte (E3, étape 5), dans son fichier hors
# dépôt : sa valeur, avec et sans les espaces qui la groupent à l'affichage ; et une
# affectation littérale à GF_SMTP_PASSWORD. Le chemin (GF_SMTP_PASSWORD__FILE) n'en est pas une.
CLES_VARIABLES+=(GRAFANA_SMTP_MOT_DE_PASSE)
CLES_FOURNISSEUR[GRAFANA_SMTP_MOT_DE_PASSE]="du canal d'alerte"
CLES_NATURE[GRAFANA_SMTP_MOT_DE_PASSE]="mot de passe"
CLES_ASPECT[GRAFANA_SMTP_MOT_DE_PASSE]="GF_SMTP_PASSWORD[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[^[:space:]\"'\$]{8,}"
# Les secrets de l'application du libraire (E4, lot 1), posés AVANT que ces secrets
# existent sur le poste :
#   - APPLICATION_CLE_SESSION : la clé de signature des sessions, dans le .env du module
#     12 ; sa valeur, et une affectation littérale de 32 caractères au moins (une
#     référence « ${…} » n'en est pas une) ;
#   - le mot de passe du rôle de connexion `app_conseiller` : sa valeur, lue dans le
#     fichier de mots de passe de PostgreSQL du poste (PGPASSFILE, sinon ~/.pgpass), sur
#     les seules lignes de ce rôle, 12 caractères au moins ; et une ligne de ce fichier
#     recopiée (le rôle entre deux « : », suivi d'une valeur ; la forme documentée,
#     « <mot de passe> », passe). La variable APP_CONSEILLER_MOT_DE_PASSE n'existe
#     pas : c'est le nom interne de ce secret ici ;
#   - un DSN qui porte un mot de passe, forme d'adresse (le rôle, « : », une valeur,
#     « @ », après le schéma postgresql) : motif seul, aucune valeur à comparer ; une
#     valeur entre chevrons ou une référence (« ${…} », « $… ») passe. La forme par mots-clés (« password=… ») n'est pas
#     cherchée : elle se confondrait avec un argument nommé du code.
CLES_VARIABLES+=(APPLICATION_CLE_SESSION APP_CONSEILLER_MOT_DE_PASSE DSN_MOT_DE_PASSE)
CLES_FOURNISSEUR[APPLICATION_CLE_SESSION]="de session de l'application"
CLES_FOURNISSEUR[APP_CONSEILLER_MOT_DE_PASSE]="du rôle de connexion de l'application"
CLES_NATURE[APP_CONSEILLER_MOT_DE_PASSE]="mot de passe"
CLES_FOURNISSEUR[DSN_MOT_DE_PASSE]="à mot de passe"
CLES_NATURE[DSN_MOT_DE_PASSE]="DSN"
CLES_ASPECT[APPLICATION_CLE_SESSION]="APPLICATION_CLE_SESSION[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[^[:space:]\"'\$]{32,}"
# « [r] » : la ligne du motif ne tombe pas sous son propre motif.
CLES_ASPECT[APP_CONSEILLER_MOT_DE_PASSE]=":app_conseille[r]:[^[:space:]<>\"'\$]{8,}"
CLES_ASPECT[DSN_MOT_DE_PASSE]="postgres(ql)?://[^[:space:]/:@\"']+:[^[:space:]@\"'<>\${}/]{3,}@"
# Les clés du catalogue (E4, lot 2a), posées AVANT que ces secrets existent sur le poste :
#   - APPLICATION_CLE_CATALOGUE : la clé de l'application auprès de l'API data du module
#     02, dans le .env du 12 ; sa valeur, et une affectation littérale de 32 caractères
#     au moins (une référence « ${…} » ou une forme entre chevrons n'en est pas une) ;
#   - API_KEYS : le trousseau de l'API data, « nom:clé,nom:clé », dans le .env du 02 ;
#     chaque clé, découpée comme celles du trousseau de l'API du modèle, et une
#     affectation littérale dont une entrée porte une clé de 32 caractères au moins.
CLES_VARIABLES+=(APPLICATION_CLE_CATALOGUE API_KEYS)
CLES_FOURNISSEUR[APPLICATION_CLE_CATALOGUE]="du catalogue de l'application"
CLES_FOURNISSEUR[API_KEYS]="du trousseau de l'API data"
CLES_ASPECT[APPLICATION_CLE_CATALOGUE]="APPLICATION_CLE_CATALOGUE[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[^[:space:]\"'\$<>]{32,}"
CLES_ASPECT[API_KEYS]="API_KEYS[\"']?[[:space:]]*[:=][[:space:]]*[\"']?([a-z0-9_-]+:[^[:space:],\"']*,)*[a-z0-9_-]+:[^[:space:],\"'\$<>]{32,}"
# Le fichier où l'outil du fournisseur range la valeur du poste.
declare -A CLES_FICHIER=([HF_TOKEN]="${HF_HOME:-$HOME/.cache/huggingface}/token")
CLES_FICHIER[GRAFANA_SMTP_MOT_DE_PASSE]="$(git rev-parse --show-toplevel 2>/dev/null)/13_monitorage/.secrets/smtp_mot_de_passe"
CLES_FICHIER[APP_CONSEILLER_MOT_DE_PASSE]="${PGPASSFILE:-$HOME/.pgpass}"

cles_valeur_env() { # <fichier .env> <variable> : sa dernière affectation, nue
    local v
    v=$(grep -E "^[[:space:]]*(export[[:space:]]+)?$2[[:space:]]*=" "$1" 2>/dev/null | tail -n 1)
    v=${v#*=}
    v=${v//$'\r'/}
    v=${v#"${v%%[![:space:]]*}"}
    case $v in
        \"*) v=${v#\"} && v=${v%%\"*} ;;
        \'*) v=${v#\'} && v=${v%%\'*} ;;
        *) v=${v%%[[:space:]]#*} && v=${v%"${v##*[![:space:]]}"} ;; # commentaire ôté
    esac
    printf '%s' "$v"
}

cles_decouper() { # <variable> ; entrée : ses valeurs, une par ligne ; sortie : à comparer
    if [ "$1" = API_MODELE_CLES ] || [ "$1" = API_KEYS ]; then
        tr ',' '\n' | sed -E 's/^[[:space:]]*[^:]*://'
    elif [ "$1" = GRAFANA_SMTP_MOT_DE_PASSE ]; then
        sed -E 'p; s/[[:space:]]+//g'
    elif [ "$1" = APP_CONSEILLER_MOT_DE_PASSE ]; then
        # Les lignes « hôte:port:base:rôle:mot de passe » du rôle (\: et \\ échappés) ;
        # le mot de passe seul, 12 caractères au moins.
        awk -v role=app_conseiller '{
            l = $0; gsub(/\\\\/, "\001", l); gsub(/\\:/, "\002", l)
            n = split(l, f, ":")
            if (n >= 5 && f[4] == role) {
                p = f[5]; for (i = 6; i <= n; i++) p = p ":" f[i]
                gsub(/\002/, ":", p); gsub(/\001/, "\\", p)
                if (length(p) >= 12) print p
            }
        }'
    else
        cat
    fi
}

cles_valeurs() { # <variable> : ses valeurs sur le poste, une par ligne, sans vide
    local racine fichier
    racine=$(git rev-parse --show-toplevel) || return 0
    {
        printf '%s\n' "${!1:-}"
        if [ -n "${CLES_FICHIER[$1]:-}" ] && [ -r "${CLES_FICHIER[$1]}" ]; then
            tr -d '\r' <"${CLES_FICHIER[$1]}"
            printf '\n'
        fi
        while IFS= read -r -d '' fichier; do
            cles_valeur_env "$fichier" "$1"
            printf '\n'
        done < <(find "$racine" -maxdepth 3 \( -name .git -o -name .venv -o -name node_modules \) \
            -prune -o -name .env \( -type f -o -type l \) -print0)
    } | cles_decouper "$1" | grep -v '^[[:space:]]*$' | sort -u
}

declare -A CLES_VALEURS=()
for _variable in "${CLES_VARIABLES[@]}"; do
    CLES_VALEURS[$_variable]=$(cles_valeurs "$_variable")
done
unset _variable

controler_cles() { # <préfixe des messages> ; entrée « chemin<TAB>ligne » ; complète echecs
    local prefixe="$1" lignes variable fournisseur nature fichier
    lignes=$(cat)
    [ -n "$lignes" ] || return 0
    for variable in "${CLES_VARIABLES[@]}"; do
        fournisseur=${CLES_FOURNISSEUR[$variable]}
        nature=${CLES_NATURE[$variable]:-clé}
        if [ -n "${CLES_VALEURS[$variable]}" ]; then
            while IFS= read -r fichier; do
                echecs+=("${prefixe}$nature $fournisseur du poste en clair dans $fichier")
            done < <(grep -aF -f <(printf '%s\n' "${CLES_VALEURS[$variable]}") <<<"$lignes" |
                cut -f1 | sort -u)
        fi
        while IFS= read -r fichier; do
            echecs+=("${prefixe}chaîne d'aspect $nature $fournisseur dans $fichier")
        done < <(grep -aE -- "${CLES_ASPECT[$variable]}" <<<"$lignes" | cut -f1 | sort -u)
    done
}
