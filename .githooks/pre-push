#!/usr/bin/env bash
# pre-push — les quatre contrôles du dépôt public, rejoués avant chaque push.
#
#   1. AUTEUR : chaque commit poussé a pour auteur ET committer TheMaxfly. Seule
#      exception, le commit de fusion créé par l'interface de GitHub : exactement
#      deux parents, pour committer l'identité technique de GitHub (nom et adresse
#      exacts), pour auteur TheMaxfly ou son nom de profil GitHub, MaxFlavigny.
#      Les contrôles 2 et 3 s'appliquent aussi à ce commit.
#   2. AUCUNE MENTION D'ASSISTANT :
#      - message de commit : ni le nom de l'assistant, ni celui de son éditeur,
#        ni un co-auteur ;
#      - lignes ajoutées : pas davantage, sauf dans les fichiers de
#        `.githooks/mentions-techniques` (usage technique : dépendance d'API,
#        crawler visé par un robots.txt) — et même là, jamais un marqueur
#        d'auteur (co-auteur, « généré avec », nom de l'outil de développement).
#   3. AUCUN FICHIER INTERDIT : aucun fichier suivi du commit poussé ne tombe sous
#      l'exclusion LOCALE (`.git/info/exclude`, jamais versionnée pour ne pas
#      nommer ces chemins), sauf `.githooks/docs-versionnes` (docs/ versionnés
#      exprès).
#   4. AUCUNE CLÉ NI AUCUN JETON (Mistral, OpenAI, Hugging Face) dans les lignes
#      ajoutées de chaque commit poussé : ni la valeur du poste en clair, ni une
#      chaîne qui en a l'aspect — `.githooks/cles-fournisseurs`, partagé avec le
#      pre-commit. Le refus nomme le fournisseur et le fichier, jamais la valeur.
#   5. RÉFÉRENCES : ni le nom d'une branche ou d'une étiquette poussée, ni le
#      message d'une étiquette annotée ne mentionnent un assistant ou un co-auteur.
#      (Le titre et le corps d'une demande de fusion — le message du commit de
#      fusion — sont contrôlés sur GitHub, par `.githooks/controler-texte`.)
#
# Les lignes sont lues en texte (grep -a) : une ligne qui porte un octet hors UTF-8
# n'est pas tue.
#
# Refuse le push si un contrôle échoue, et dit lequel. Sans exclusion locale, le
# contrôle 3 est impossible : refus aussi — le hook ne passe pas à l'aveugle.
#
# Activation (une fois par clone) :
#   ln -sf ../../.githooks/pre-push .git/hooks/pre-push
# Essai : bash .githooks/tester.sh
#
# Les motifs s'écrivent avec des classes de caractères : le hook ne contient pas
# les mots qu'il cherche, sinon il se refuserait lui-même.
set -uo pipefail

AUTEUR="TheMaxfly"
# Committer des commits de fusion créés par l'interface de GitHub : relevé sur de
# vrais commits de fusion (2026-10-09), nom et adresse exacts.
VALIDATEUR_GITHUB="GitHub <noreply@github.com>"
# Auteur des fusions faites par TheMaxfly dans l'interface de GitHub : son nom de
# profil (relevé), admis pour ces seules fusions.
AUTEUR_PROFIL_GITHUB="MaxFlavigny"
MOTS='cl[a]ude|anthr[o]pic|co-author[e]d-by'
SIGNATURES='co-author[e]d-by|generat[e]d (with|by) cl[a]ude|g[eé]n[eé]r[eé] (avec|par) cl[a]ude|cl[a]ude[ -]code|cl[a]ude\.ai'
ZERO=0000000000000000000000000000000000000000

distant="${1:-origin}"
exclusion="$(git rev-parse --git-path info/exclude)"
echecs=()
fragment="$(git rev-parse --show-toplevel)/.githooks/cles-fournisseurs"
if [ ! -r "$fragment" ]; then
    echo "pre-push : PUSH REFUSÉ — .githooks/cles-fournisseurs introuvable : clés non contrôlables." >&2
    exit 1
fi
# shellcheck source=cles-fournisseurs
. "$fragment"

liste_du_commit() {  # liste versionnée, lue dans le commit poussé
    git show "$1:.githooks/$2" 2>/dev/null | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' || true
}

lignes_ajoutees() {  # « chemin<TAB>ligne » pour chaque ligne ajoutée du commit
    git show --format= --unified=0 --no-color --no-ext-diff \
        --diff-merges=first-parent "$1" |
        awk '/^\+\+\+ / { f = substr($0, 7); next }
             /^\+/      { print f "\t" substr($0, 2) }'
}

while read -r local_ref local_sha distant_ref distant_sha; do
    [ "$local_sha" = "$ZERO" ] && continue  # suppression de branche
    # 5. références : leur nom, et le message d'une étiquette annotée
    while read -r ref; do
        grep -qaiE "$MOTS" <<<"$ref" &&
            echecs+=("référence « $ref » : son nom mentionne un assistant")
    done < <(printf '%s\n%s\n' "$local_ref" "$distant_ref" | sort -u)
    if [ "$(git cat-file -t "$local_sha")" = tag ] &&
        git cat-file -p "$local_sha" | sed '1,/^$/d' | grep -qaiE "$MOTS|$SIGNATURES"; then
        echecs+=("étiquette « $local_ref » : son message mentionne un assistant ou un co-auteur")
    fi
    if [ "$distant_sha" = "$ZERO" ] || ! git cat-file -e "$distant_sha" 2>/dev/null; then
        commits=$(git rev-list "$local_sha" --not --remotes="$distant")
    else
        commits=$(git rev-list "$distant_sha..$local_sha")
    fi
    techniques=$(liste_du_commit "$local_sha" mentions-techniques)

    for c in $commits; do
        court=$(git rev-parse --short "$c")
        # 1. auteur et committer — exception : la fusion créée par GitHub
        IFS='|' read -r auteur committer adresse parents < <(git log -1 --format='%an|%cn|%ce|%P' "$c")
        if [ "$(wc -w <<<"$parents")" -eq 2 ] && [ "$committer <$adresse>" = "$VALIDATEUR_GITHUB" ]; then
            [ "$auteur" = "$AUTEUR" ] || [ "$auteur" = "$AUTEUR_PROFIL_GITHUB" ] ||
                echecs+=("$court : auteur « $auteur » d'une fusion créée par GitHub, attendu « $AUTEUR » ou « $AUTEUR_PROFIL_GITHUB »")
        else
            [ "$auteur" = "$AUTEUR" ] || echecs+=("$court : auteur « $auteur », attendu « $AUTEUR »")
            [ "$committer" = "$AUTEUR" ] ||
                echecs+=("$court : committer « $committer <$adresse> », attendu « $AUTEUR » (ou « $VALIDATEUR_GITHUB » pour une fusion à deux parents)")
        fi
        # 2a. message
        if git log -1 --format=%B "$c" | grep -qaiE "$MOTS"; then
            echecs+=("$court : le message de commit mentionne un assistant ou un co-auteur")
        fi
        # 2b. lignes ajoutées
        while IFS=$'\t' read -r chemin ligne; do
            if printf '%s\n' "$ligne" | grep -qaiE "$SIGNATURES"; then
                echecs+=("$court : marqueur d'auteur ajouté dans $chemin")
            elif printf '%s\n' "$ligne" | grep -qaiE "$MOTS" &&
                ! grep -qxF "$chemin" <<<"$techniques"; then
                echecs+=("$court : mention d'assistant ajoutée dans $chemin (fichier hors de .githooks/mentions-techniques)")
            fi
        done < <(lignes_ajoutees "$c" | grep -aiE "$MOTS|$SIGNATURES" || true)
        # 4. clés et jetons des fournisseurs, dans les lignes ajoutées
        controler_cles "$court : " < <(lignes_ajoutees "$c")
    done

    # 3. fichiers interdits, dans l'arbre poussé
    if [ ! -s "$exclusion" ]; then
        echecs+=("exclusion locale absente ($exclusion) : contrôle des fichiers interdits impossible")
    else
        permis=$(liste_du_commit "$local_sha" docs-versionnes)
        index=$(mktemp)
        GIT_INDEX_FILE="$index" git read-tree "$local_sha"
        while read -r fichier; do
            [ -n "$fichier" ] || continue
            grep -qxF "$fichier" <<<"$permis" && continue
            echecs+=("fichier interdit dans $(git rev-parse --short "$local_sha") : $fichier")
        done < <(GIT_INDEX_FILE="$index" git ls-files -i -c --exclude-from="$exclusion")
        rm -f "$index"
    fi
done

if [ ${#echecs[@]} -gt 0 ]; then
    echo "pre-push : PUSH REFUSÉ — ${#echecs[@]} contrôle(s) en échec :" >&2
    printf '  - %s\n' "${echecs[@]}" >&2
    exit 1
fi
echo "pre-push : auteur, mentions, fichiers, clés et jetons, références — contrôles passés." >&2
exit 0
