# Configuration de sauvegarde/sauvegarder.sh — un modèle. La copier en
# sauvegarde/.env (ignoré par git) et la compléter : ce fichier-ci ne porte aucun
# chemin du poste. Chemins RELATIFS à $HOME, sans « .. » ; une clé par ligne.

# Le dépôt et l'état local de la sauvegarde (valeurs par défaut).
DEPOT=certification-Dev_IA
RACINE_SAUVEGARDES=sauvegardes
# La procédure copiée en clair sur le support (défaut : <RACINE_SAUVEGARDES>/RESTAURATION.md).
# RESTAURATION=sauvegardes/RESTAURATION.md
BASES=apimanga manganews

# Les objets sauvegardés : un FICHIER= par objet (fichier ou dossier).
FICHIER=certification-Dev_IA/10_mesures_recherche/resultats
FICHIER=certification-Dev_IA/09_service_embedding/mesures
FICHIER=certification-Dev_IA/05_nettoyage_agregation_bdd/data/rapports
FICHIER=certification-Dev_IA/04_scraping_manga_sanctuary/data/raw
FICHIER=certification-Dev_IA/03_kitsu_api_exports/exports
# … et les documents de travail hors dépôt du poste.
