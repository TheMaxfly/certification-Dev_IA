APP_ENV=development
APP_NAME=API Manga
APP_VERSION=0.4.0

# Trousseau d'autorisation, au format « nom:clé,nom2:clé2 ».
#
# Le nom désigne le CONSOMMATEUR (« app_backend »), pas une personne : le client
# final ne détient jamais de clé, c'est le back-end qui la porte. La clé fait au
# moins 32 caractères.
#
# LAISSÉ VIDE À DESSEIN : ce fichier est versionné et ne contiendra jamais de clé
# réelle. Tel quel, il fait REFUSER le démarrage de l'API — c'est le comportement
# voulu. Générer la vôtre dans `.env`, qui n'est pas versionné :
#
#   echo "API_KEYS=app_backend:$(openssl rand -base64 32 | tr -d '=+/' | cut -c1-40)" >> .env
API_KEYS=

# API dans Docker, PostgreSQL sur l'hôte : host.docker.internal
# API lancée localement avec uvicorn : remplacer par localhost
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=apimanga
DB_USER=manga_api
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=5
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
