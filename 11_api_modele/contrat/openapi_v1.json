    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Clé d'accès du consommateur, une par application.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "L'API du modèle d'embedding en service : une question entre, les séries du\ncatalogue classées par le modèle sortent, avec les passages qui les justifient.\nLe classement est celui que le banc de mesure a mesuré.\n\nToutes les routes métier sont sous `/v1/` et demandent une clé (`X-API-Key`).\n`/v1/` ne reçoit que des ajouts compatibles ; une rupture ouvre `/v2/`.\n\nDepuis 1.1.0, `/v1/reponse` : un modèle de langage, choisi par profil, rédige en\nfrançais une réponse tirée des seuls passages de la recherche, ou refuse ; la réponse\nporte ses sources, le profil, les réglages, les jetons, le coût et les latences.\n",
    "title": "API du modèle",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "info_v1_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Clé d'accès absente ou invalide."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Débit dépassé pour cette clé."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Le modèle, l'encodage et le corpus servis ; réglages et bornes",
        "tags": [
          "exploitation"
        ]
      }
    },
    "/v1/recherche": {
      "post": {
        "operationId": "rechercher_v1_recherche_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recherche"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resultat"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Clé d'accès absente ou invalide."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Corps de requête trop volumineux."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Entrée invalide (`entree_invalide`) ou question trop longue (`question_trop_longue`)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Débit dépassé pour cette clé."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Service d'embedding indisponible ou incohérent, base indisponible, ou encodage en service changé depuis le démarrage."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Les séries classées pour une question, avec leurs passages",
        "tags": [
          "recherche"
        ]
      }
    },
    "/v1/reponse": {
      "post": {
        "operationId": "repondre_v1_reponse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemandeReponse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Clé d'accès absente ou invalide."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Corps de requête trop volumineux."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Entrée invalide (`entree_invalide`), question trop longue (`question_trop_longue`), historique invalide (`historique_invalide`), profil inconnu ou indisponible (`profil_inconnu`, `profil_indisponible`), réglage que le profil n'expose pas (`reglage_non_expose`). Aucun appel au modèle n'a eu lieu."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Débit dépassé pour cette clé."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "La recherche ne répond pas : service d'embedding indisponible (`service_embedding_indisponible`) ou incohérent (`service_embedding_incoherent`), base indisponible (`base_indisponible`), encodage en service changé depuis le démarrage (`encodage_en_service_change`) ; le fournisseur du modèle est injoignable (`fournisseur_injoignable`), trop lent (`fournisseur_delai`) ou refuse l'appel (`fournisseur_refus`) ; la sortie du modèle ne tient pas le contrat (`sortie_modele_invalide`, son motif dans les détails)."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Une réponse rédigée par le modèle de langage, des seuls passages",
        "tags": [
          "reponse"
        ]
      }
    },
    "/v1/sante": {
      "get": {
        "operationId": "sante_v1_sante_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "base": "injoignable",
                  "encodage": "inconnu",
                  "service_embedding": "ok",
                  "statut": "degrade"
                },
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Un composant ne répond pas."
          }
        },
        "summary": "Vivant ; base, service et encodage en service cohérents",
        "tags": [
          "exploitation"
        ]
      }
    }
  }
}
