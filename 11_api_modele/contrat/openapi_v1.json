      "DemandeReponse": {
        "additionalProperties": false,
        "description": "Une question, l'historique de la conversation et les réglages de la réponse ;\nun champ inconnu est refusé.",
        "properties": {
          "catalogue_seul": {
            "default": true,
            "title": "Catalogue Seul",
            "type": "boolean"
          },
          "historique": {
            "description": "Les tours précédents, dans l'ordre : au plus 10 tours et 4000 caractères ; ni gardés ni journalisés.",
            "items": {
              "$ref": "#/components/schemas/Tour"
            },
            "title": "Historique",
            "type": "array"
          },
          "identite": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._@:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recopiée dans le journal, sans effet sur la réponse.",
            "title": "Identite"
          },
          "longueur_max": {
            "default": 400,
            "description": "Jetons de sortie au plus.",
            "maximum": 1000.0,
            "minimum": 50.0,
            "title": "Longueur Max",
            "type": "integer"
          },
          "mode": {
            "const": "strict",
            "default": "strict",
            "title": "Mode",
            "type": "string"
          },
          "nombre_series": {
            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Nombre Series",
            "type": "integer"
          },
          "passages_par_serie": {
            "default": 2,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Passages Par Serie",
            "type": "integer"
          },
          "profil": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Le profil qui rédige (un profil déclaré) ; le profil actif par défaut.",
            "title": "Profil"
          },
          "question": {
            "description": "La question du libraire, dernier tour de la conversation.",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "reformuler": {
            "default": true,
            "description": "Avec un historique : réécrire la question en question autonome avant la recherche.",
            "title": "Reformuler",
            "type": "boolean"
          },
          "temperature": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          }
        },
        "required": [
          "question"
        ],
        "title": "DemandeReponse",
        "type": "object"
      },
