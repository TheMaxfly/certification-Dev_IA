          "doc_key",
          "type_document",
          "score",
          "extrait"
        ],
        "title": "Passage",
        "type": "object"
      },
      "ProfilDecrit": {
        "properties": {
          "disponible": {
            "description": "La clé du profil est présente (et, si le contrôle d'exploitation a tourné au démarrage, le modèle figure chez le fournisseur).",
            "title": "Disponible",
            "type": "boolean"
          },
          "fournisseur": {
            "title": "Fournisseur",
            "type": "string"
          },
          "modele": {
            "description": "L'identifiant du modèle chez le fournisseur.",
            "title": "Modele",
            "type": "string"
          },
          "nom": {
            "title": "Nom",
            "type": "string"
          },
          "reglages_absents": {
            "description": "Les réglages que ce profil n'expose pas : les demander est refusé.",
            "items": {
              "type": "string"
            },
            "title": "Reglages Absents",
            "type": "array"
          },
          "statut": {
            "enum": [
              "stable",
              "apercu"
            ],
            "title": "Statut",
            "type": "string"
          },
          "variable_cle": {
            "description": "Le NOM de la variable d'environnement de la clé, jamais sa valeur.",
            "title": "Variable Cle",
            "type": "string"
          }
        },
        "required": [
          "nom",
          "fournisseur",
          "modele",
          "statut",
          "disponible",
          "reglages_absents",
          "variable_cle"
        ],
        "title": "ProfilDecrit",
        "type": "object"
      },
      "Question": {
        "properties": {
          "longueur_max_caracteres": {
            "title": "Longueur Max Caracteres",
            "type": "integer"
          }
        },
        "required": [
          "longueur_max_caracteres"
        ],
        "title": "Question",
        "type": "object"
      },
      "Recherche": {
        "additionalProperties": false,
        "description": "Une question et ses réglages ; rien d'autre (un champ inconnu est refusé).",
        "properties": {
          "catalogue_seul": {
            "default": true,
            "title": "Catalogue Seul",
            "type": "boolean"
          },
          "identite": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._@:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recopiée dans le journal, sans effet sur la réponse.",
            "title": "Identite"
          },
          "nombre_series": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Nombre Series",
            "type": "integer"
          },
          "passages_par_serie": {
            "default": 1,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Passages Par Serie",
            "type": "integer"
          },
          "question": {
            "description": "Le texte de la question, encodé tel quel.",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "Recherche",
        "type": "object"
      },
      "ReglagesAppliques": {
        "properties": {
          "catalogue_seul": {
            "title": "Catalogue Seul",
            "type": "boolean"
          },
          "nombre_series": {
            "title": "Nombre Series",
            "type": "integer"
          },
          "passages_par_serie": {
            "title": "Passages Par Serie",
            "type": "integer"
          }
        },
        "required": [
          "nombre_series",
          "passages_par_serie",
          "catalogue_seul"
        ],
        "title": "ReglagesAppliques",
        "type": "object"
      },
      "ReglagesRecherche": {
        "properties": {
          "catalogue_seul": {
            "$ref": "#/components/schemas/BorneBooleenne"
          },
          "nombre_series": {
            "$ref": "#/components/schemas/BorneEntiere"
          },
          "passages_par_serie": {
            "$ref": "#/components/schemas/BorneEntiere"
          }
        },
        "required": [
          "nombre_series",
          "passages_par_serie",
          "catalogue_seul"
        ],
        "title": "ReglagesRecherche",
        "type": "object"
      },
      "ReglagesReponse": {
        "description": "Les réglages de la route de réponse : défauts et bornes (`reglages.toml`).",
        "properties": {
          "catalogue_seul": {
            "$ref": "#/components/schemas/BorneBooleenne"
          },
          "historique": {
            "$ref": "#/components/schemas/HistoriqueDecrit"
          },
          "longueur_max": {
            "$ref": "#/components/schemas/BorneEntiere"
          },
          "mode": {
            "$ref": "#/components/schemas/ModeDecrit"
          },
          "nombre_series": {
            "$ref": "#/components/schemas/BorneEntiere"
          },
          "passages_par_serie": {
            "$ref": "#/components/schemas/BorneEntiere"
          },
          "reformuler": {
            "$ref": "#/components/schemas/BorneBooleenne"
          },
          "temperature": {
            "$ref": "#/components/schemas/BorneReelle"
          }
        },
        "required": [
          "temperature",
          "longueur_max",
          "mode",
          "historique",
          "reformuler",
          "nombre_series",
          "passages_par_serie",
          "catalogue_seul"
        ],
        "title": "ReglagesReponse",
        "type": "object"
      },
      "Resultat": {
        "properties": {
          "contexte": {
            "$ref": "#/components/schemas/Contexte"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/Serie"
            },
            "title": "Series",
            "type": "array"
          }
        },
        "required": [
          "series",
          "contexte"
        ],
        "title": "Resultat",
        "type": "object"
      },
      "Sante": {
        "description": "Vivant ; base et service joignables ; ce qui est servi est toujours en service.\n\nDes états seulement : ni version ni modèle (route sans clé).",
        "properties": {
          "base": {
            "enum": [
              "ok",
              "injoignable"
            ],
            "title": "Base",
            "type": "string"
          },
          "encodage": {
            "description": "ok : l'encodage chargé au démarrage est toujours celui de la vue ; change : une promotion ou un retour arrière a eu lieu depuis (redémarrer) ; inconnu : la base ne répond pas.",
            "enum": [
              "ok",
              "change",
              "inconnu"
            ],
            "title": "Encodage",
            "type": "string"
          },
          "service_embedding": {
            "enum": [
              "ok",
              "injoignable",
              "incoherent"
            ],
            "title": "Service Embedding",
            "type": "string"
          },
          "statut": {
            "enum": [
              "ok",
              "degrade"
            ],
            "title": "Statut",
            "type": "string"
          }
        },
        "required": [
          "statut",
          "base",
          "service_embedding",
          "encodage"
        ],
        "title": "Sante",
        "type": "object"
      },
      "Serie": {
        "properties": {
          "entite": {
            "description": "« serie:<id> » ou « kitsu:<id> », la clé du banc.",
            "title": "Entite",
            "type": "string"
          },
          "kitsu_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kitsu Id"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "title": "Passages",
            "type": "array"
          },
          "rang": {
            "title": "Rang",
            "type": "integer"
          },
          "score": {
            "description": "Cosinus du meilleur fragment (non arrondi).",
            "title": "Score",
            "type": "number"
          },
          "serie_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serie Id"
          },
          "titre": {
            "title": "Titre",
            "type": "string"
          }
        },
        "required": [
          "rang",
          "entite",
          "serie_id",
          "kitsu_id",
          "titre",
          "score",
          "passages"
        ],
        "title": "Serie",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Clé d'accès du consommateur, une par application.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "L'API du modèle d'embedding en service : une question entre, les séries du\ncatalogue classées par le modèle sortent, avec les passages qui les justifient.\nLe classement est celui que le banc de mesure a mesuré.\n\nToutes les routes métier sont sous `/v1/` et demandent une clé (`X-API-Key`).\n`/v1/` ne reçoit que des ajouts compatibles ; une rupture ouvre `/v2/`.\n",
    "title": "API du modèle",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "info_v1_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Clé d'accès absente ou invalide."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Débit dépassé pour cette clé."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Le modèle, l'encodage et le corpus servis ; réglages et bornes",
        "tags": [
          "exploitation"
        ]
      }
    },
    "/v1/recherche": {
      "post": {
        "operationId": "rechercher_v1_recherche_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recherche"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resultat"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Clé d'accès absente ou invalide."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Corps de requête trop volumineux."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Entrée invalide (`entree_invalide`) ou question trop longue (`question_trop_longue`)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Débit dépassé pour cette clé."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Service d'embedding indisponible ou incohérent, base indisponible, ou encodage en service changé depuis le démarrage."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Les séries classées pour une question, avec leurs passages",
        "tags": [
          "recherche"
        ]
      }
    },
    "/v1/sante": {
      "get": {
        "operationId": "sante_v1_sante_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Un composant ne répond pas."
          }
        },
        "summary": "Vivant ; base, service et encodage en service cohérents",
        "tags": [
          "exploitation"
        ]
      }
    }
  }
}
