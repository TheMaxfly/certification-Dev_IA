        "type": "object"
      },
      "ModeleLangage": {
        "description": "Le modèle de langage : le profil qui rédige, les profils déclarés, les\nréglages de la réponse. Distinct de `modele`, le modèle d'embedding.",
        "properties": {
          "profil_actif": {
            "title": "Profil Actif",
            "type": "string"
          },
          "profils": {
            "items": {
              "$ref": "#/components/schemas/ProfilDecrit"
            },
            "title": "Profils",
            "type": "array"
          },
          "reglages_reponse": {
            "$ref": "#/components/schemas/ReglagesReponse"
          }
        },
        "required": [
          "profil_actif",
          "profils",
          "reglages_reponse"
        ],
        "title": "ModeleLangage",
        "type": "object"
      },
      "Passage": {
        "properties": {
          "doc_key": {
            "title": "Doc Key",
            "type": "string"
          },
          "extrait": {
            "title": "Extrait",
            "type": "string"
          },
          "fragment_id": {
            "title": "Fragment Id",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "type_document": {
            "enum": [
              "critique",
              "resume_serie",
