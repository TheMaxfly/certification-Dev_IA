          "serie_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serie Id"
          },
          "titre": {
            "title": "Titre",
            "type": "string"
          }
        },
        "required": [
