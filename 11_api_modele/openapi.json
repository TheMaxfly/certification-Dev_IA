          }
        },
        "required": [
          "longueur_max_caracteres"
        ],
        "title": "Question",
        "type": "object"
      },
      "ReglagesRecherche": {
        "properties": {
          "catalogue_seul": {
            "$ref": "#/components/schemas/BorneBooleenne"
          },
          "nombre_series": {
            "$ref": "#/components/schemas/BorneEntiere"
          },
          "passages_par_serie": {
            "$ref": "#/components/schemas/BorneEntiere"
          }
