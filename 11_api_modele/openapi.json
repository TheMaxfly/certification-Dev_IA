      },
      "Sante": {
        "description": "Vivant ; base et service joignables ; ce qui est servi est toujours en service.\n\nDes états seulement : ni version ni modèle (route sans clé).",
        "properties": {
          "base": {
            "enum": [
              "ok",
              "injoignable"
            ],
            "title": "Base",
            "type": "string"
          },
          "encodage": {
            "description": "ok : l'encodage chargé au démarrage est toujours celui de la vue ; change : une promotion ou un retour arrière a eu lieu depuis (redémarrer) ; inconnu : la base ne répond pas.",
            "enum": [
              "ok",
              "change",
              "inconnu"
            ],
            "title": "Encodage",
            "type": "string"
          },
          "service_embedding": {
            "enum": [
              "ok",
              "injoignable",
              "incoherent"
            ],
            "title": "Service Embedding",
            "type": "string"
          },
          "statut": {
            "enum": [
              "ok",
              "degrade"
            ],
            "title": "Statut",
            "type": "string"
          }
        },
        "required": [
          "statut",
          "base",
          "service_embedding",
          "encodage"
        ],
        "title": "Sante",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Clé d'accès du consommateur, une par application.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "L'API du modèle d'embedding en service : une question entre, les séries du\ncatalogue classées par le modèle sortent, avec les passages qui les justifient.\nLe classement est celui que le banc de mesure a mesuré.\n\nToutes les routes métier sont sous `/v1/` et demandent une clé (`X-API-Key`).\n`/v1/` ne reçoit que des ajouts compatibles ; une rupture ouvre `/v2/`.\n",
    "title": "API du modèle",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "info_v1_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Clé d'accès absente ou invalide."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            },
            "description": "Débit dépassé pour cette clé."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Le modèle, l'encodage et le corpus servis ; réglages et bornes",
        "tags": [
          "exploitation"
        ]
      }
    },
    "/v1/sante": {
      "get": {
        "operationId": "sante_v1_sante_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            },
            "description": "Un composant ne répond pas."
          }
        },
        "summary": "Vivant ; base, service et encodage en service cohérents",
        "tags": [
          "exploitation"
        ]
      }
    }
  }
}
