          }
        },
        "required": [
          "defaut",
          "min",
          "max"
        ],
        "title": "BorneEntiere",
        "type": "object"
      },
      "Erreur": {
        "description": "La forme de toute erreur de l'API.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
