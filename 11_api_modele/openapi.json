          },
          "identifiant_requete": {
            "title": "Identifiant Requete",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "identifiant_requete"
        ],
        "title": "Erreur",
        "type": "object"
      },
      "Info": {
        "description": "Ce que l'API sert : modèle, encodage, corpus, réglages et leurs bornes.",
        "properties": {
          "corpus_id": {
            "title": "Corpus Id",
            "type": "string"
          },
          "debit_par_minute": {
            "title": "Debit Par Minute",
            "type": "integer"
          },
          "dimension": {
            "title": "Dimension",
            "type": "integer"
          },
          "encodage_id": {
            "title": "Encodage Id",
            "type": "integer"
          },
          "modele": {
            "title": "Modele",
            "type": "string"
          },
          "nb_fragments": {
            "title": "Nb Fragments",
            "type": "integer"
          },
          "outil": {
            "title": "Outil",
            "type": "string"
          },
          "outil_version": {
            "title": "Outil Version",
            "type": "string"
          },
          "precision": {
            "title": "Precision",
            "type": "string"
          },
          "question": {
            "$ref": "#/components/schemas/Question"
          },
          "reglages": {
            "$ref": "#/components/schemas/ReglagesRecherche"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "version_api": {
            "title": "Version Api",
            "type": "string"
          }
        },
        "required": [
