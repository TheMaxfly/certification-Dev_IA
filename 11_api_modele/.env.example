# Modèle du fichier `.env` de l'API du modèle : le copier en `.env` (ignoré par git).
# Aucune valeur réelle ici. Les défauts, les bornes et le motif de chaque réglage
# sont dans `config/reglages.toml`, versionné. Le même `.env` sert au lancement direct
# (`uv run --env-file .env python -m api_modele`) et au Compose (`docker compose`).

# Clés d'accès acceptées, une par consommateur : `nom:clé,nom:clé`. Noms en
# minuscules (`application`, `demonstration`) ; clé de 32 caractères au moins.
# Vide : l'API refuse de démarrer.
API_MODELE_CLES=

# Connexion à la base sous `modele_api` (membre de `modele_ro`, migration 023), sans
# mot de passe : il est dans ~/.pgpass. Exemple de forme :
#   postgresql://modele_api@localhost:5432/apimanga
API_MODELE_DSN=

# --- Surcharges d'exploitation (facultatives ; défauts et motifs : reglages.toml) ---
# Hôte du service d'embedding (défaut : celui du module 09).
# CLIENT_HOTE=
# Requêtes par minute et par clé (défaut 60).
# API_MODELE_DEBIT_PAR_MINUTE=
# Réseaux admis à lire /metrics, séparés par des virgules (défaut : le bouclage).
# API_MODELE_METRIQUES_RESEAUX=
# Le texte des questions au journal : vrai ou faux (défaut : faux).
# API_MODELE_JOURNAL_QUESTION=
# La documentation interactive (Swagger UI, /v1/docs) : vrai ou faux (défaut : faux).
# API_MODELE_DOCUMENTATION=
# Adresse et port d'écoute (défaut 127.0.0.1:8010).
# API_MODELE_HOTE=
# API_MODELE_PORT=

# --- Compose (docker-compose.yml) — facultatif, défauts entre parenthèses ---------
# Mode processeur, sans carte graphique (défaut : la carte) :
# COMPOSE_FILE=docker-compose.yml:compose.cpu.yml
# Connexion à la base DEPUIS le conteneur, sans mot de passe
# (postgresql://modele_api@host.docker.internal:5432/apimanga) :
# API_MODELE_DSN_CONTENEUR=
# Le fichier pgpass monté en secret dans le conteneur de l'API, mode 600, une ligne
# `host.docker.internal:5432:apimanga:modele_api:<mot de passe>` (./.pgpass.conteneur,
# ignoré par git) :
# API_MODELE_PGPASS=
# L'utilisateur de l'hôte, sous lequel tournent les conteneurs : propriétaire du cache
# des poids et seul lecteur du pgpass (1000 et 1000) :
# HOTE_UID=
# HOTE_GID=
# Le cache Hugging Face de l'hôte, où sont les poids à la révision épinglée
# (~/.cache/huggingface/hub) :
# HF_HUB_CACHE_HOTE=
# Adresse et port publiés de l'API sur l'hôte (127.0.0.1 et 8010) — l'adresse locale
# par défaut : ne l'ouvrir qu'en connaissance de cause :
# API_MODELE_ADRESSE_PUBLIEE=
# API_MODELE_PORT_PUBLIE=
