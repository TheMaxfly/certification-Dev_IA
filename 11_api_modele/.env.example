# Modèle du fichier `.env` de l'API du modèle : le copier en `.env` (ignoré par git).
# Aucune valeur réelle ici. Les défauts, les bornes et le motif de chaque réglage
# sont dans `config/reglages.toml`, versionné.

# Clés d'accès acceptées, une par consommateur : `nom:clé,nom:clé`. Noms en
# minuscules (`application`, `demonstration`) ; clé de 32 caractères au moins.
# Vide : l'API refuse de démarrer.
API_MODELE_CLES=

# Connexion à la base sous `modele_api` (membre de `modele_ro`, migration 023), sans
# mot de passe : il est dans ~/.pgpass. Exemple de forme :
#   postgresql://modele_api@localhost:5432/apimanga
API_MODELE_DSN=

# --- Surcharges d'exploitation (facultatives ; défauts et motifs : reglages.toml) ---
# Hôte du service d'embedding (défaut : celui du module 09).
# CLIENT_HOTE=
# Requêtes par minute et par clé (défaut 60).
# API_MODELE_DEBIT_PAR_MINUTE=
# Réseaux admis à lire /metrics, séparés par des virgules (défaut : le bouclage).
# API_MODELE_METRIQUES_RESEAUX=
# Le texte des questions au journal : vrai ou faux (défaut : faux).
# API_MODELE_JOURNAL_QUESTION=
# Adresse et port d'écoute (défaut 127.0.0.1:8010).
# API_MODELE_HOTE=
# API_MODELE_PORT=
