# La cible staging : la pile de l'étiquette sur la base de préproduction.
# Passé EN DERNIER à `docker compose --env-file` : ce qui suit l'emporte sur les fichiers
# des modules. Aucun secret ici (le hook et un test le vérifient) ; la clé de session du
# staging est dans 12_application/.env.staging, hors dépôt.
COMPOSE_PROJECT_NAME=senpai-staging
# Le monitorage est levé, comme en production : la chaîne panne → alerte → courriel se
# répète ici avant la production. Mêmes ports pour Prometheus et Grafana (écrits au
# Compose du 13) : les deux cibles ne tournent jamais ensemble. Les données de Prometheus
# sont dans un volume du projet, propres au staging.
LIVRER_MONITORAGE=oui
# La sonde du 13, en staging : elle ne lit pas la base (pas même la préproduction) et
# n'écrit pas dans le journal de la sonde de production.
MONITORAGE_LECTURE_BASE=0
MONITORAGE_DSN_LECTURE=
MONITORAGE_JOURNAL_SONDE=/dev/null
DB_NAME=apimanga_preprod
API_MODELE_DSN_CONTENEUR=postgresql://modele_api@host.docker.internal:5432/apimanga_preprod
APPLICATION_BASE_DSN_CONTENEUR=postgresql://app_conseiller@host.docker.internal:5432/apimanga_preprod
APPLICATION_ENVIRONNEMENT=preproduction
# Les ports de la production + 1.
APPLICATION_PORT_PUBLIE=8021
CATALOGUE_PORT_PUBLIE=8001
# Comme le 13 en production ; aucun appel au fournisseur au démarrage.
API_MODELE_VERIFIER_MODELES=false
