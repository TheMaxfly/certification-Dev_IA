# La cible production : la pile du monitorage (projet api-modele : 11 + 12 + 13) sur la
# base apimanga, aux ports actuels.
# Passé EN DERNIER à `docker compose --env-file` : ce qui suit l'emporte sur les fichiers
# des modules. Aucun secret ici (le hook et un test le vérifient).
COMPOSE_PROJECT_NAME=api-modele
LIVRER_MONITORAGE=oui
DB_NAME=apimanga
API_MODELE_DSN_CONTENEUR=postgresql://modele_api@host.docker.internal:5432/apimanga
APPLICATION_BASE_DSN_CONTENEUR=postgresql://app_conseiller@host.docker.internal:5432/apimanga
APPLICATION_ENVIRONNEMENT=production
APPLICATION_PORT_PUBLIE=8020
CATALOGUE_PORT_PUBLIE=8000
